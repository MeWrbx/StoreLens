# Open Cloud API key from https://create.roblox.com/dashboard/credentials
# Needs universe-datastores.objects:read (add :write and :delete to edit)
ROBLOX_API_KEY=

# Optional, loaded automatically on startup
ROBLOX_UNIVERSE_ID=

PORT=3000
HOST=127.0.0.1

# true disables writes and deletes server-side
READ_ONLY=false
