# Open Cloud API key from https://create.roblox.com/dashboard/credentials
# Needs universe-datastores.objects:read (add :write and :delete to edit)
ROBLOX_API_KEY=

# Optional, loaded automatically on startup
ROBLOX_UNIVERSE_ID=

PORT=3000
HOST=127.0.0.1

# true disables writes and deletes server-side
READ_ONLY=false

# Scheduled backups. 0 or unset = off. Minimum 5, and backups only read,
# so they keep running in read-only mode.
BACKUP_INTERVAL_MIN=0
BACKUP_DIR=backups
# Comma separated. Empty = every store the key can see.
BACKUP_STORES=
# How many files to keep per store before the oldest is dropped.
BACKUP_KEEP=7
# 1-20000. A value outside that stops backups from starting.
BACKUP_MAX_ENTRIES=2000
